# Required: from app.spatius.ai
SPATIUS_API_KEY=
SPATIUS_APP_ID=
# us-west (default) or your region
SPATIUS_REGION=us-west

# Optional: your own OpenAI key. Without it, the CEO uses 30 free Spatius starter minutes.
OPENAI_API_KEY=

# Optional: ElevenLabs voices (each person has their own voice, with a native voice for Arabic).
# Without it, the OpenAI voice is used. Your key needs text-to-speech access.
ELEVENLABS_API_KEY=

# Optional: where the page starts (the visitor can still change the language)
# Language: en, es, zh, ar, fr
CEO_LANG=en
# Your company, company story and new hires, instead of the samples. Write \n for a new line.
# CEO_COMPANY=Example Ltd
# CEO_STORY=## Our mission\nMake every clinic run on time.\n## What each team does\n### Sales\nSales finds the clinics that need us most.
# CEO_PEOPLE=Sam Rivera, Account executive, Sales, 2026-12-01
# Seconds per session (0 for no limit)
CEO_SECONDS=180
# PORT=3000
